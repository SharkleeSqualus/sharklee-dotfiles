{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "source": "arch",
    "padding": {
	    "top": 4,
      "left": 2,
      "right": 2,
               }
  },
  "modules": [
//OS
    {
    "key": "󰣇 OS",
    "type": "os"
    },
//Host
    {
    "key": "󱩛 Host",
    "type": "host"
    },
//Display Sharklee use Arch
    {
    "type": "custom",
    "format": "󱢺 Sharklee use EndeavourOS (Arch) BTW"
    },
    "separator",
//Kernel
    {
    "key":  " Kernel",
    "type":"kernel"
    },
//Uptime
     {       
     "key" : " Uptime",
     "type": "uptime"
     },
//OS age
     {
    "key": " OS age",
    "type": "disk",
    "folders": "/",
    "format": "{create-time:10}, {days} Days {hours} Hours"
     },
//Packages
     {
    "key": "󰏗 Packages",
    "type":"packages"
     },
//Shell
     {
     "key": " Shell",
     "type":"shell"
     },
//DE
     {
     "key": " DE",
     "type": "de"
     },
//WM 
     {
     "key":" WM",
     "type":"wm"
     },
//Terminal
     {
     "key":" Terminal",
     "type" : "terminal"
     },
     "separator",
//CPU
     {
     "key": " CPU",
     "type": "cpu"
     },
//GPU
     {
     "key": "󰿀 GPU",
     "type": "gpu"
     },
//Memory
     {
     "key": " RAM",
     "type": "memory"
     },
//Display
     {
     "key": "󰍹 Monitors",
     "type": "display"
     },
//Disk
     {
     "key": " Disk",
     "type": "disk"
     },
//Battery
//     {
//     "key": " Battery",
//     "type":"battery"
//     },
  ]
}
